[Unit]
Description=Calendar-driven F1 collection and publication monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/f1-commentary-scheduler
Environment=PATH=%h/.local/share/f1-watchdog/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.local/share/f1-watchdog/venv/bin/python3 %h/projects/f1-commentary-scheduler/ops/calendar_scheduler.py
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/projects/f1-commentary-scheduler %h/.local/state/f1-watchdog %h/.cache %h/.config/gh
ReadOnlyPaths=%h/.ssh
MemoryMax=512M
TasksMax=64
